{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_comment": "데이터바우처 사업계획서 자동작성 - 마스터 스키마 (3계층 구조)",
  "layers": {
    "master": "기업 공통정보 — 변경 빈도 낮음. 한 번 입력 후 반복 재사용.",
    "project": "아이템/과제 정보 — 사업 공모별로 약간 달라짐.",
    "program": "공모별 제약 규칙 — 공고마다 완전히 달라짐."
  },
  "master": {
    "company": {
      "name": {
        "type": "string",
        "description": "기업명",
        "required": true
      },
      "biz_no": {
        "type": "string",
        "description": "사업자등록번호 (###-##-#####)",
        "required": true
      },
      "founded": {
        "type": "string",
        "description": "설립일 (YYYY-MM-DD)",
        "required": true
      },
      "address": {
        "type": "string",
        "description": "소재지",
        "required": true
      },
      "industry": {
        "type": "string",
        "description": "주요 업종/산업 분야",
        "required": true
      },
      "employee_count": {
        "type": "integer",
        "description": "현재 재직인원 수",
        "required": true
      },
      "annual_revenue": {
        "type": "number",
        "description": "최근 연매출 (원)",
        "required": false
      }
    },
    "ceo": {
      "name": {
        "type": "string",
        "description": "대표자 이름",
        "required": true
      },
      "career": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "대표자 주요 이력 (순서대로)",
        "required": true
      },
      "expertise": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "대표자 핵심 전문 분야",
        "required": true
      }
    },
    "core_competency": {
      "description": "기업 핵심역량 3~5가지",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": true
    }
  },
  "project": {
    "meta": {
      "program_name": {
        "type": "string",
        "description": "지원사업 공식 명칭",
        "required": true
      },
      "project_title": {
        "type": "string",
        "description": "과제명 — 데이터 중심 명칭 필수",
        "required": true
      },
      "data_use_purpose": {
        "type": "string",
        "enum": [
          "운영효율화",
          "제품서비스개선",
          "신제품개발",
          "시장개척",
          "리스크관리",
          "기타"
        ],
        "description": "데이터 활용 목적 (1개 선택)",
        "required": true
      },
      "goal_100char": {
        "type": "string",
        "description": "데이터 활용 목표 (100자 이내)",
        "required": true
      }
    },
    "narrative": {
      "problem": {
        "type": "string",
        "description": "문제인식/추진배경/필요성 (Problem)",
        "required": true
      },
      "solution": {
        "type": "string",
        "description": "실현방안/제품·서비스 내용 (Solution)",
        "required": true
      },
      "market_status": {
        "type": "string",
        "description": "시장현황/목표시장/경쟁현황 (Market)",
        "required": true
      },
      "bm_intro": {
        "type": "string",
        "description": "수익모델/사업화 전략 (BM)",
        "required": false
      },
      "differentiator": {
        "type": "string",
        "description": "특장점/차별화 요소",
        "required": false
      },
      "expected_effect": {
        "type": "string",
        "description": "기대효과/향후계획 (Scale-up)",
        "required": true
      }
    },
    "budget_mix": {
      "_comment": "사업비 편성 비중 (%). 합계=100. 구매 또는 가공 중 최소 1개 > 0 필수.",
      "planning": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "기획 (%)"
      },
      "purchase": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "구매 (%)"
      },
      "collection": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "수집 (%)"
      },
      "processing": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "가공 (%)"
      },
      "analysis": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "분석 (%)"
      },
      "required": true
    },
    "budget_total": {
      "type": "integer",
      "description": "총 사업비 (원)",
      "required": true
    },
    "schedule": {
      "type": "array",
      "description": "추진일정 (월별 태스크)",
      "_item_fields": {
        "task": {
          "type": "string",
          "description": "업무명"
        },
        "m1": {
          "type": "boolean",
          "description": "1개월차"
        },
        "m2": {
          "type": "boolean",
          "description": "2개월차"
        },
        "m3": {
          "type": "boolean",
          "description": "3개월차"
        },
        "m4": {
          "type": "boolean",
          "description": "4개월차"
        },
        "m5": {
          "type": "boolean",
          "description": "5개월차"
        },
        "m6": {
          "type": "boolean",
          "description": "6개월차"
        },
        "weight": {
          "type": "integer",
          "description": "비중 (%) — 합계 100"
        }
      },
      "required": true
    },
    "team": {
      "type": "array",
      "description": "수행인력 목록",
      "_item_fields": {
        "name": {
          "type": "string",
          "description": "성명"
        },
        "role": {
          "type": "string",
          "description": "역할/직책"
        },
        "participation": {
          "type": "integer",
          "description": "참여율 (%)"
        },
        "is_new_hire": {
          "type": "boolean",
          "description": "신규 채용 여부"
        }
      },
      "required": true
    },
    "assets": {
      "type": "array",
      "description": "삽입할 이미지 목록 (최대 1장)",
      "_item_fields": {
        "title": {
          "type": "string",
          "description": "이미지 제목"
        },
        "path": {
          "type": "string",
          "description": "이미지 파일 경로"
        }
      }
    },
    "privacy": {
      "uses_personal_data": {
        "type": "boolean",
        "description": "개인정보 활용 여부",
        "required": true
      },
      "privacy_manager": {
        "type": "string",
        "description": "개인정보보호관리자 (uses_personal_data=true 시 필수)"
      }
    }
  },
  "program": {
    "name": "데이터바우처",
    "year": 2026,
    "constraints": {
      "title_must_include_data": true,
      "purchase_or_processing_required": true,
      "image_max_count": 1,
      "goal_char_limit": 100,
      "budget_bias_warning_threshold": 70,
      "participation_must_match_labor_cost": true,
      "personal_data_manager_required_if_used": true,
      "blue_text_must_be_removed": true,
      "original_format_must_be_kept": true,
      "personal_info_in_doc_forbidden": true
    },
    "section_keywords": {
      "overview": "사업(과제) 개요",
      "purpose": "목적 및 필요성",
      "market": "시장현황",
      "solution": "실현방안",
      "bm": "비즈니스 모델",
      "differentiator": "특장점",
      "expected_effect": "기대효과",
      "schedule": "추진일정",
      "budget": "사업비 편성",
      "team": "수행인력",
      "hire_plan": "추가 인력 고용계획",
      "image": "관련 이미지"
    }
  }
}